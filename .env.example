# VERTEXSCOPE の設定例。`cp .env.example .env` して編集してください。
# .env は .gitignore 済みです。認証情報そのものは絶対に書かないでください。

# ── 公開ポート (ホスト側) ──
VERTEXSCOPE_PORT=8080

# ── 接続先 (UI からも設定・変更できます) ──
VERTEXSCOPE_PROJECT_ID=
VERTEXSCOPE_LOCATION=global
VERTEXSCOPE_COLLECTION=default_collection

# ── 認証 ──
# 既定ではホストの gcloud ADC (~/.config/gcloud) をコンテナに読み取り専用でマウントします。
# 別の場所にある場合のみ指定してください。
# GCLOUD_CONFIG_DIR=~/.config/gcloud
#
# サービスアカウントキーを使う場合は、docker-compose.yml の ./secrets マウントを
# 有効にしたうえでコンテナ内のパスを指定します。
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

# ── ネットワーク境界 (通常は変更不要) ──
# ブラウザからの API 呼び出しを許可するオリジン (カンマ区切り)。
# 空ならループバックの既定値が使われます。
# VERTEXSCOPE_ALLOWED_ORIGINS=
#
# 受け付ける Host ヘッダ (DNS リバインディング対策)。`*` で無効化。
# VERTEXSCOPE_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── その他 ──
# プレビューで中継する最大バイト数 (既定 64MiB)
# VERTEXSCOPE_MAX_PREVIEW_BYTES=67108864
# ログレベル
# VERTEXSCOPE_LOG_LEVEL=INFO
